# ShopPilot environment variables.
#
# Copy this file to `.env` and fill in the values. Next.js loads `.env*`
# natively (no `dotenv` needed); everything here is validated by Zod in
# `src/lib/env.ts` at startup — the app fails fast if a required var is missing.
#
# NEVER commit the real `.env` (it is gitignored).

# --- Runtime -------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# --- Database ------------------------------------------------------------
# MongoDB connection string.
# Local dev on this machine uses the system mongod on 127.0.0.1:27017.
# With Docker instead: see docker-compose.yml (mongodb service).
MONGODB_URI=mongodb://127.0.0.1:27017/shoppilot

# --- LLM (Phase 2) -------------------------------------------------------
# Which provider adapter the factory in src/modules/llm/index.ts constructs.
#   mock  -> deterministic scripted responses, no API key needed (DEFAULT)
#   grok  -> xAI Grok via its OpenAI-compatible API (requires GROK_API_KEY)
#   groq  -> GroqCloud via its OpenAI-compatible API (requires SHOPSY_API_KEY)
LLM_PROVIDER=mock

# xAI Grok credentials — only required when LLM_PROVIDER=grok.
GROK_API_KEY=
GROK_MODEL=grok-3
GROK_BASE_URL=https://api.x.ai

# Groq credentials — only required when LLM_PROVIDER=groq.
# (The key is named SHOPSY_API_KEY; the value is a Groq `gsk_...` key.)
SHOPSY_API_KEY=
SHOPSY_MODEL=llama-3.3-70b-versatile
SHOPSY_BASE_URL=https://api.groq.com/openai

# Set to 1 to allow live external tests (Grok/Groq API calls). Default 0: all tests
# use the mock or HTTP-level fakes, and no real key is ever touched.
RUN_LIVE_TESTS=0

# --- Product source (Phase 3) --------------------------------------------
# Which ProductSource the factory in src/modules/products/index.ts constructs.
#   mock -> deterministic fixture catalog (DEFAULT for dev + tests)
#   live -> real HTTP adapter; requires PRODUCT_SOURCE_BASE_URL
PRODUCT_SOURCE=mock
# Only needed when PRODUCT_SOURCE=live.
PRODUCT_SOURCE_BASE_URL=
PRODUCT_SOURCE_API_KEY=

# Seller trust policy — code-enforced thresholds (never the LLM's opinion).
# A listing must meet BOTH to be trusted; official brand stores bypass them
# when the policy's officialBypass is on (default).
TRUST_MIN_RATING=4.0
TRUST_MIN_RATING_COUNT=50
